WORDPRESS_GRAPHQL_ENDPOINT=http://admin.shomansolutions.com/graphql
# Optional, only if your GraphQL API requires authentication:
# WORDPRESS_GRAPHQL_TOKEN=

# Required for Gravity Forms contact submissions.
GRAVITY_FORM_CUSTOMER_KEY=
GRAVITY_FORM_CUSTOMER_SECRET=
# Optional override; defaults to the production form 2 endpoint.
# GRAVITY_FORM_ENDPOINT=https://admin.shomansolutions.com/gravityformsapi/forms/2/submissions
# Optional override for the homepage email capture form (Gravity Form 3).
# GRAVITY_EMAIL_FORM_ENDPOINT=https://admin.shomansolutions.com/gravityformsapi/forms/3/submissions
